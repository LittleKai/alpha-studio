{
  "version": 2,
  "buildCommand": "npm run build:seo",
  "outputDirectory": "dist",
  "proxy": {
    "entrypoint": "middleware.js"
  },
  "routes": [
    {
      "src": "^/event-creative-city/?$",
      "status": 410
    },
    {
      "src": "^/co-loa-living-spiral(?:/.*)?$",
      "status": 410
    },
    {
      "src": "^/studio/interior-design(?:/.*)?$",
      "status": 410
    },
    {
      "src": "^/sitemap\\.xml$",
      "dest": "https://alpha-studio-backend.fly.dev/sitemap.xml"
    },
    {
      "src": "^/robots\\.txt$",
      "dest": "/robots.txt"
    },
    {
      "src": "^/assets/(.*)$",
      "headers": {
        "cache-control": "public, max-age=31536000, immutable"
      },
      "continue": true
    },
    {
      "src": "^/led-studio/(?:css/[^/]+\\.css|js/(?:core|modules)/.+\\.js|js/data/(?:meshopt-decoder|ofl-fixtures)\\.js)$",
      "headers": {
        "cache-control": "public, max-age=31536000, immutable"
      },
      "continue": true
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/"
    }
  ]
}
