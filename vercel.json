{
  "version": 2,
  "buildCommand": "npm run build:seo",
  "outputDirectory": "dist",
  "proxy": { "entrypoint": "middleware.js" },
  "routes": [
    { "src": "^/event-creative-city/?$", "status": 410 },
    { "src": "^/co-loa-living-spiral(?:/.*)?$", "status": 410 },
    { "src": "^/studio/interior-design(?:/.*)?$", "status": 410 },
    { "src": "^/sitemap\\.xml$", "dest": "https://alpha-studio-backend.fly.dev/sitemap.xml" },
    { "src": "^/robots\\.txt$", "dest": "/robots.txt" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/" }
  ]
}
